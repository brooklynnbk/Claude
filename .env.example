# Copy this file to .env and fill in what you use. Restart HQ after changes.

# ---- AI health coach (required for the Coach chat) ----
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: model and how hard it thinks (low | medium | high)
# COACH_MODEL=claude-opus-5-5
# COACH_EFFORT=medium

# ---- Apple Calendar via iCloud (optional, private) ----
# Use an app-specific password from account.apple.com → Sign-In and Security.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# Optional: only include these calendars (comma-separated names)
# ICLOUD_CALENDARS=Home,Work

# ---- Protect the app with a password (recommended if others can reach it) ----
APP_PASSWORD=
# SESSION_SECRET=any-long-random-string

# ---- Server ----
# PORT=3000
# DATA_DIR=data
# Set to 1 when running behind a reverse proxy / HTTPS tunnel
# TRUST_PROXY=1
