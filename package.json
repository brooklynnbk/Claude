{
  "name": "brooklynn-hq",
  "version": "1.0.0",
  "private": true,
  "description": "Personal app: Apple Calendar, habit tracker, sticker shop weekly orders, and an AI health coach.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ical.js": "^2.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "tsdav": "^2.5.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
